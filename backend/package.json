{
  "name": "arthouse-atlas-backend",
  "version": "1.0.0",
  "description": "Backend API for Arthouse Atlas movie discovery platform",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "seed": "node scripts/seedDatabase.js",
    "seed:movies": "node scripts/seedMovies.js",
    "test": "node --test tests/",
    "recs:download": "node scripts/recs/download.js",
    "recs:export": "node scripts/recs/exportCatalogue.js",
    "recs:prepare": "node scripts/recs/prepare.js",
    "recs:evaluate": "node scripts/recs/evaluate.js",
    "recs:final": "node scripts/recs/evaluate.js --final",
    "recs:build": "node scripts/recs/build.js"
  },
  "keywords": [
    "arthouse",
    "cinema",
    "movies",
    "MERN"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.6.2",
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^8.6.2",
    "google-auth-library": "^10.5.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.0.3",
    "seedrandom": "^3.0.5"
  },
  "devDependencies": {
    "nodemon": "^3.0.2",
    "sharp": "^0.33.5",
    "world-atlas": "^2.0.2"
  }
}
